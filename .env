# Environment Configuration
ASPNETCORE_ENVIRONMENT=Development

# Database
DatabaseOptions__ConnectionString=Server=localhost;Database=HomeServicesDb;Trusted_Connection=True;MultipleActiveResultSets=true;Encrypt=False

# JWT
JwtOptions__Secret=YourSuperSecretKeyForDevelopmentEnvironment12345!
JwtOptions__Issuer=HomeServices
JwtOptions__Audience=HomeServices_Clients
JwtOptions__ExpiryMinutes=1440

# Redis
RedisOptions__ConnectionString=localhost:6379

# Storage
StorageOptions__ConnectionString=UseDevelopmentStorage=true
StorageOptions__ContainerName=uploads
