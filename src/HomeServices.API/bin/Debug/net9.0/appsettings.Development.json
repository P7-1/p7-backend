{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    }
  },
  "DatabaseOptions": {
    "ConnectionString": "Server=localhost;Database=HomeServicesDb_Dev;Trusted_Connection=True;MultipleActiveResultSets=true;Encrypt=False"
  },
  "JwtOptions": {
    "Secret": "SuperSecretKeyForDevelopmentEnvironment12345!",
    "Issuer": "HomeServices_Dev",
    "Audience": "HomeServices_Clients",
    "ExpiryMinutes": 1440
  },
  "RedisOptions": {
    "ConnectionString": "localhost:6379"
  },
  "StorageOptions": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "ContainerName": "dev-uploads"
  }
}
