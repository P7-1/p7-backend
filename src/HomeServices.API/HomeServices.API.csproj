<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HomeServices.API</RootNamespace>
    <AssemblyName>HomeServices.API</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UserSecretsId>homeservices-api-dev</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <!-- API Layer NuGet Packages -->
  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.*" />
    <PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="7.*" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR" Version="1.*" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.*" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Versioning" Version="5.*" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Versioning.ApiExplorer" Version="5.*" />
    <PackageReference Include="AspNetCoreRateLimit" Version="5.*" />
  </ItemGroup>

  <!-- Project References - API is the composition root, references everything -->
  <ItemGroup>
    <ProjectReference Include="..\HomeServices.Application\HomeServices.Application.csproj" />
    <ProjectReference Include="..\HomeServices.Domain\HomeServices.Domain.csproj" />
    <ProjectReference Include="..\HomeServices.Infrastructure\HomeServices.Infrastructure.csproj" />
    <ProjectReference Include="..\HomeServices.Persistence\HomeServices.Persistence.csproj" />
    <ProjectReference Include="..\HomeServices.Contracts\HomeServices.Contracts.csproj" />
    <ProjectReference Include="..\HomeServices.Shared\HomeServices.Shared.csproj" />
  </ItemGroup>

</Project>
