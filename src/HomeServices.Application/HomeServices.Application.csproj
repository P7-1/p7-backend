<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HomeServices.Application</RootNamespace>
    <AssemblyName>HomeServices.Application</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Application Layer NuGet Packages -->
  <ItemGroup>
    <PackageReference Include="MediatR" Version="12.3.0" />
    <PackageReference Include="AutoMapper" Version="13.0.1" />
    <PackageReference Include="FluentValidation" Version="11.9.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.9.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.*" />
  </ItemGroup>

  <!-- Project References - Application depends on Domain, Contracts, Shared -->
  <ItemGroup>
    <ProjectReference Include="..\HomeServices.Domain\HomeServices.Domain.csproj" />
    <ProjectReference Include="..\HomeServices.Contracts\HomeServices.Contracts.csproj" />
    <ProjectReference Include="..\HomeServices.Shared\HomeServices.Shared.csproj" />
  </ItemGroup>

</Project>
